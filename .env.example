# BoiAI — configuração de ambiente
# Copie para .env e ajuste.

# MySQL
MYSQL_ROOT_PASSWORD=boiai_root
MYSQL_DATABASE=boiai
MYSQL_USER=boiai
MYSQL_PASSWORD=boiai_secret
MYSQL_PORT=3306
DATABASE_URL=mysql+pymysql://boiai:boiai_secret@localhost:3306/boiai

# Qdrant (vetores do RAG)
QDRANT_URL=http://localhost:6333

# Ollama (daemon no host ou container)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=bge-m3
# Nível de raciocínio padrão: false | true | low | medium | high
OLLAMA_THINK=medium

# API
API_PORT=8000
API_JWT_SECRET=troque-esta-chave-em-producao
API_JWT_EXPIRES_MIN=43200

# Importador MySQL externo (ex.: banco legado da Hostinger)
# IMPORT_MYSQL_HOST=
# IMPORT_MYSQL_USER=
# IMPORT_MYSQL_PASSWORD=
# IMPORT_MYSQL_DATABASE=
